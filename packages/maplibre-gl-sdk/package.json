{
  "name": "@mapka/maplibre-gl-sdk",
  "version": "0.17.2",
  "type": "module",
  "description": "Mapka JS SDK",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mapka-dev/sdk.git"
  },
  "exports": {
    ".": "./lib/index.js",
    "./styles.css": "./lib/styles.css"
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "styles": "lightningcss --minify --bundle ./src/styles.css -o lib/styles.css",
    "styles:watch": "nodemon --watch src --ext css --exec yarn styles"
  },
  "keywords": [
    "map",
    "maplibre",
    "mapka",
    "sdk"
  ],
  "author": "chyzwar",
  "license": "Apache-2.0",
  "dependencies": {
    "@maplibre/maplibre-gl-style-spec": "^26.5.1",
    "@types/geojson": "^7946.0.16",
    "es-toolkit": "^1.52.0",
    "html-to-image": "^1.11.13",
    "ky": "^2.1.0",
    "maplibre-gl": "^6.17.0",
    "preact": "^10.29.8",
    "supercluster": "^9.1.0",
    "terra-draw": "^1.33.0",
    "terra-draw-maplibre-gl-adapter": "^1.4.1"
  },
  "devDependencies": {
    "@chyzwar/tsconfig": "^0.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "happy-dom": "^20.14.5",
    "lightningcss": "^1.33.0",
    "lightningcss-cli": "^1.33.0",
    "nodemon": "^3.1.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0"
  },
  "files": [
    "src/",
    "lib/",
    "!**/__tests__/",
    "!lib/buildInfo.json"
  ]
}
